# amber — warm dark greys, amber focus, red for urgency.
# Colours are rgb:rr/gg/bb because spectrwm cuts a line at an unescaped '#'.
# theme-apply splices this file into the marked block in ~/.spectrwm.conf.
color_focus             = rgb:ff/b0/00
color_unfocus           = rgb:17/14/0f
color_urgent            = rgb:d9/0d/10
color_focus_maximized   = rgb:ff/b0/00
color_unfocus_maximized = rgb:17/14/0f
color_urgent_maximized  = rgb:d9/0d/10
bar_enabled             = 1
bar_at_bottom           = 0
bar_border_width        = 1
bar_border[1]           = rgb:ff/b0/00
bar_border_unfocus[1]   = rgb:2a/24/1b
bar_color[1]            = rgb:0f/0e/0c,rgb:17/14/0f,rgb:20/1b/14,rgb:d9/0d/10
bar_color_unfocus[1]    = rgb:0f/0e/0c,rgb:17/14/0f,rgb:20/1b/14,rgb:d9/0d/10
bar_font_color[1]       = rgb:ff/b0/00,rgb:e6/de/d0,rgb:8a/81/75,rgb:d9/0d/10
bar_font_color_unfocus[1] = rgb:8a/81/75,rgb:8a/81/75,rgb:5c/55/4a,rgb:d9/0d/10
bar_color_selected      = rgb:ff/b0/00
bar_font_color_selected = rgb:0f/0e/0c
bar_font                = BlexMono Nerd Font:pixelsize=16:antialias=true
# workspace indicators: keep marks simple/reliable for spectrwm 3.7.0; styling
# is intentionally minimal to prioritize visibility over decoration.
workspace_mark_current        = [
workspace_mark_current_suffix = ] 
workspace_mark_active         =  
workspace_mark_active_suffix  =  
workspace_mark_empty          =  
workspace_mark_empty_suffix   =  
workspace_mark_urgent         = !
workspace_mark_urgent_suffix  =  
