#!/bin/sh
# open — what lf runs when you press Enter on a file.
#
# lf opens directories itself, so this only ever sees files.  Everything is
# started in the background so lf keeps its terminal.
#
#   text/*            mg in a fresh st window
#   image/*           feh
#   application/pdf   zathura
#   anything else     xdg-open, or a notification when it is missing

set -u

for f in "$@"; do
	[ -f "$f" ] || continue

	mime=$(file -bL --mime-type "$f" 2>/dev/null) || mime=

	case $mime in
	text/*|application/json|application/xml|application/x-shellscript|inode/x-empty)
		st -e mg "$f" >/dev/null 2>&1 &
		;;
	image/*)
		feh --auto-zoom --image-bg '#0f0e0c' "$f" >/dev/null 2>&1 &
		;;
	application/pdf)
		zathura "$f" >/dev/null 2>&1 &
		;;
	*)
		if command -v xdg-open >/dev/null 2>&1; then
			xdg-open "$f" >/dev/null 2>&1 &
		elif command -v notify-send >/dev/null 2>&1; then
			notify-send -a lf 'lf' "no handler for ${f##*/} (${mime:-unknown})" &
		fi
		;;
	esac
done
