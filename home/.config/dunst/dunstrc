# ~/.config/dunst/dunstrc — amber desktop notifications
# Installed by theme-apply from themes/<name>/dunstrc.

[global]
    monitor = 0
    follow = none

    width = 340
    height = (0, 200)
    origin = top-right
    # comfortable margin (no permanent bar in cwm)
    offset = (14, 14)
    scale = 0

    notification_limit = 6

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 240
    progress_bar_max_width = 340
    progress_bar_corner_radius = 0
    highlight = "#ffb000"

    frame_width = 1
    frame_color = "#2a241b"

    gap_size = 6

    separator_color = frame
    sort = yes

    font = BlexMono Nerd Font 11
    line_height = 0
    markup = full

    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 24
    max_icon_size = 64
    icon_path = /usr/local/share/icons/Papirus-Dark:/usr/local/share/icons/Papirus:/usr/local/share/icons/hicolor/48x48/apps:/usr/share/pixmaps:/usr/local/share/pixmaps

    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"

    sticky_history = yes
    history_length = 20

    dmenu = /usr/local/bin/rofi -dmenu -p dunst:
    browser = /usr/local/bin/xdg-open
    always_run_script = true

    title = Dunst
    class = Dunst

    corner_radius = 0
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#17140f"
    foreground = "#8a8175"
    timeout = 6
    frame_color = "#2a241b"

[urgency_normal]
    background = "#0f0e0c"
    foreground = "#e6ded0"
    timeout = 8
    frame_color = "#ffb000"

[urgency_critical]
    background = "#0f0e0c"
    foreground = "#e6ded0"
    timeout = 0
    frame_color = "#d90d10"

# Short-lived overlays for hardware/media changes
[volume]
    appname = volume
    timeout = 2
    set_stack_tag = volume
    urgency = normal

[brightness]
    appname = brightness
    timeout = 2
    set_stack_tag = brightness
    urgency = normal

[keyboard]
    appname = keyboard
    timeout = 2
    set_stack_tag = kbdlight
    urgency = low

[audio]
    appname = audio
    timeout = 3
    set_stack_tag = audio
    urgency = low
