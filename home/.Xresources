! ---------------------------------------------------------------------------
!  ~/.Xresources — amber desktop
!  theme-apply installs this from themes/<name>/Xresources.
!
!  The T480s panel is 1920x1080 across 14 inches (~157 dpi), so 96 dpi text is
!  uncomfortably small. 120 dpi gives roughly the 1.25x an Omarchy-style
!  desktop would use, without forcing GTK scaling on everything.
! ---------------------------------------------------------------------------

Xft.dpi: 120

! Cursor
Xcursor.theme: Adwaita
Xcursor.size: 24

! Font rendering
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb

! Classic X clients (xterm, xcalc, xmessage, ...)
*foreground:    #e6ded0
*background:    #0f0e0c
*cursorColor:   #ffb000
*highlightColor: #ffb000
*pointerColor:  #ffb000
*borderColor:   #2a241b
