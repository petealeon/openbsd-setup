#!/bin/sh
# games — RetroArch launcher (Super+Shift+G)
#
# Layout: ~/Games/<system>/roms/*, one directory per console.  Pick a system
# from the menu and the first ROM is passed to RetroArch with the matching
# libretro core; pick "RetroArch" to land in its own menu instead.
#
# Cores come from the libretro-* packages in packages.txt and live in
# /usr/local/lib/libretro on OpenBSD.

set -u

roms="$HOME/Games"
libretro="${LIBRETRO_DIR:-/usr/local/lib/libretro}"

core_for() {
	case $1 in
	megadrive|genesis|mastersystem|gamegear) echo genesis_plus_gx ;;
	snes|supernintendo)                      echo snes9x ;;
	nes|famicom)                             echo nestopia ;;
	gameboy|gb|gbc)                          echo gambatte ;;
	gba)                                     echo mgba ;;
	psx|playstation)                         echo pcsx_rearmed ;;
	psp)                                     echo ppsspp ;;
	*)                                       echo ;;
	esac
}

systems=$(
	if [ -d "$roms" ]; then
		for d in "$roms"/*/; do
			[ -d "$d" ] || continue
			basename "$d"
		done
	fi
)

choice=$(printf '%s\n' "RetroArch" $systems |
	rofi -dmenu -i -p 'games' -no-custom)

[ -n "$choice" ] || exit 0

if [ "$choice" = RetroArch ]; then
	exec retroarch
fi

dir="$roms/$choice/roms"
[ -d "$dir" ] || dir="$roms/$choice"
rom=$(find "$dir" -type f \( -iname '*.zip' -o -iname '*.sfc' -o -iname '*.smc' \
	-o -iname '*.nes' -o -iname '*.gba' -o -iname '*.gb' -o -iname '*.gbc' \
	-o -iname '*.md' -o -iname '*.gen' -o -iname '*.bin' -o -iname '*.cue' \
	-o -iname '*.iso' -o -iname '*.chd' -o -iname '*.pbp' \) 2>/dev/null |
	sed -n 1p)

[ -n "$rom" ] || {
	notify-send -a games "games" "no ROM found in ${dir##*/}" 2>/dev/null || true
	exit 1
}

core=$(core_for "$choice")
if [ -n "$core" ] && [ -f "$libretro/${core}_libretro.so" ]; then
	exec retroarch -L "$libretro/${core}_libretro.so" "$rom"
fi

# Unknown system or missing core: let RetroArch pick by file association.
exec retroarch "$rom"
