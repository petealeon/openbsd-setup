#!/bin/sh
# launcher — rofi command centre (Super+space)
#
# `launcher drun` jumps straight to the application list.

set -u

drun() {
	exec rofi -show drun -show-icons
}

wm_name() {
	if pgrep -qx cwm 2>/dev/null; then
		echo cwm
	elif pgrep -qx spectrwm 2>/dev/null; then
		echo spectrwm
	else
		echo wm
	fi
}

wm=$(wm_name)

reload_wm() {
	case $wm in
	cwm)      pkill -HUP cwm 2>/dev/null || true ;;
	spectrwm) command -v xdotool >/dev/null 2>&1 && \
			xdotool key --clearmodifiers super+ctrl+r 2>/dev/null || \
			pkill -HUP spectrwm 2>/dev/null || true ;;
	*)        : ;;
	esac
}

logout_wm() {
	case $wm in
	cwm)      pkill -TERM cwm 2>/dev/null || true ;;
	spectrwm) pkill -TERM spectrwm 2>/dev/null || true ;;
	*)        pkill -TERM "${wm:-cwm}" 2>/dev/null || true ;;
	esac
}

[ "${1:-}" = drun ] && drun

choice=$(printf '%s\n' \
	'apps' \
	'windows' \
	'files' \
	'music' \
	'games' \
	'wifi' \
	'audio output' \
	'download video' \
	'keybinds' \
	'screenshot region' \
	'lock' \
	'night light' \
	"reload wm" \
	'hibernate' \
	'suspend (S3)' \
	'reboot' \
	'power off' \
	'log out' |
	rofi -dmenu -i -p '›' -no-custom)

case $choice in
apps)              rofi -show drun -show-icons ;;
windows)           rofi -show window -show-icons ;;
files)             "$HOME/bin/files" ;;
music)             "$HOME/bin/music" ;;
games)             "$HOME/bin/games" ;;
wifi)              "$HOME/bin/wifi" ;;
'audio output')    "$HOME/bin/audio-output" ;;
'download video')  "$HOME/bin/video-download" ;;
keybindings)       "$HOME/bin/keybinds" ;;
'screenshot region') "$HOME/bin/screenshot region" ;;
lock)              "$HOME/bin/lock" ;;
'night light')     "$HOME/bin/nightlight toggle" ;;
'reload wm')       reload_wm ;;
hibernate)         doas /usr/sbin/ZZZ ;;
suspend\ \(S3\))   doas /usr/sbin/zzz ;;
reboot)            doas /sbin/reboot ;;
'power off')       doas /sbin/shutdown -p now ;;
'log out')         logout_wm ;;
'')                exit 0 ;;
esac
