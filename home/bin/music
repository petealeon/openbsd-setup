#!/bin/sh
# music — start mpd if it is not running, then open ncmpcpp in st.
#
# mpd is a per-user daemon here (no system service): its state lives under
# ~/.local/share/mpd, its config in ~/.config/mpd/mpd.conf.

set -u

state="$HOME/.local/share/mpd"
mkdir -p "$state/playlists" "$HOME/Music" "$HOME/.local/share/ncmpcpp" 2>/dev/null || true

if command -v mpc >/dev/null 2>&1; then
	if ! mpc ping >/dev/null 2>&1; then
		mpd "$HOME/.config/mpd/mpd.conf" >/dev/null 2>&1 || true
		i=0
		while [ "$i" -lt 20 ] && ! mpc ping >/dev/null 2>&1; do
			sleep 0.1
			i=$((i + 1))
		done
	fi
fi

exec st -e ncmpcpp
