#!/bin/sh
# volume [up|down|mute|toggle] [step-percent]
#
# Drives the sndio master output and shows a dunst progress bar. Bound to the
# XF86 audio keys in ~/.spectrwm.conf. sndiokeys is deliberately *not*
# installed: it would adjust the same mixer a second time for every keypress.

set -u

step=${2:-5}

notify() {
	pct=$(sndioctl -n output.level 2>/dev/null | sed -n 1p |
		awk '{ printf "%d", $1 * 100 + 0.5 }')
	[ -n "$pct" ] || pct=0
	command -v notify-send >/dev/null 2>&1 || return 0
	if [ "$(sndioctl -n output.mute 2>/dev/null | sed -n 1p)" = 1 ]; then
		notify-send -a volume -h string:x-dunst-stack-tag:volume \
			"volume" "muted"
	else
		notify-send -a volume -h string:x-dunst-stack-tag:volume \
			-h "int:value:$pct" "volume" "$pct%"
	fi
}

case ${1:-toggle} in
up|down)
	cur=$(sndioctl -n output.level 2>/dev/null | sed -n 1p)
	case $cur in
	''|*[!0-9.]*)
		echo "${0##*/}: sndioctl unavailable" >&2
		exit 1
		;;
	esac
	if [ "$1" = up ]; then delta="$step"; else delta="-$step"; fi
	new=$(awk -v c="$cur" -v d="$delta" 'BEGIN {
		v = c + d / 100;
		if (v > 1) v = 1;
		if (v < 0) v = 0;
		printf "%.2f", v
	}')
	sndioctl -q output.mute=0 || exit 1
	sndioctl -q "output.level=$new" || exit 1
	notify
	;;
mute|toggle)
	cur=$(sndioctl -n output.mute 2>/dev/null | sed -n 1p)
	if [ "$cur" = 1 ]; then
		sndioctl -q output.mute=0 || exit 1
	else
		sndioctl -q output.mute=1 || exit 1
	fi
	notify
	;;
*)
	echo "usage: ${0##*/} [up|down|mute|toggle] [step]" >&2
	exit 1
	;;
esac
