#!/bin/sh
# vm - manage the OpenBSD rehearsal VM and move configuration in and out of it.
# The repo containing this script is the deliverable; the VM is disposable.
set -eu

NAME=${OPENBSD_VM_NAME:-openbsd}
DIR=${OPENBSD_VM_DIR:-$HOME/VMs/openbsd}
REPO=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SSH_HOST=${OPENBSD_SSH_HOST:-openbsd}
ISO=${OPENBSD_VM_ISO:-$DIR/install80.iso}
DISK=$DIR/openbsd.qcow2
GUEST_USER=${OPENBSD_VM_USER:-${USER:-}}
[ -n "$GUEST_USER" ] || GUEST_USER=user
GUEST_HOME=${OPENBSD_VM_HOME:-/home/$GUEST_USER}
VM_MAC=${OPENBSD_VM_MAC:-}
V="virsh --connect qemu:///system"

usage() {
	cat <<'EOF'
Usage: vm <command> [args]

  new         create the domain (then run the installer)
  bootstrap   copy this repo to the guest and run provision.sh --vm
              (first run needs /etc/doas.conf; see README)
  up          start the domain
  down        graceful shutdown (ACPI power button)
  off         hard power off
  status      domain state and guest address
  ssh [args]  shell on the guest (or run a command)
  console     serial console (escape with Ctrl-])
  run <cmd>   run a command on the guest, no file sync
  apply       push etc/ + etc-vm/ + home/ to the guest, validate, restart sshd
  capture     pull tracked config from the guest back into this repo
  snap [tag]  snapshot the domain
  rebuild     destroy domain and disk, then 'vm new' again

Environment: OPENBSD_VM_NAME, OPENBSD_VM_DIR, OPENBSD_VM_ISO, OPENBSD_SSH_HOST,
             OPENBSD_VM_USER, OPENBSD_VM_HOME, OPENBSD_VM_MAC
EOF
}

check_libvirt() {
	if ! $V list >/dev/null 2>&1; then
		echo "error: no libvirt access. Log out and back in so the libvirt group applies." >&2
		exit 1
	fi
}

case ${1:-} in
new)
	check_libvirt
	mkdir -p "$DIR"
	[ -f "$ISO" ] || { echo "error: missing $ISO" >&2; exit 1; }
	# OVMF varstore in qcow2: libvirt refuses internal snapshots when the
	# pflash nvram is raw. qemu-img ships with qemu.
	NV=$DIR/OVMF_VARS.qcow2
	[ -f "$NV" ] || qemu-img convert -f raw -O qcow2 \
		/usr/share/edk2/x64/OVMF_VARS.4m.fd "$NV"
	virt-install --connect qemu:///system --name "$NAME" \
		--memory 6144 --vcpus 4 \
		--machine q35 \
		--boot loader=/usr/share/edk2/x64/OVMF_CODE.4m.fd,loader.readonly=yes,loader.type=pflash,nvram.template=$NV,nvram.templateFormat=qcow2 \
		--disk path="$DISK",size=40,format=qcow2,bus=virtio,cache=writeback,discard=unmap \
		--cdrom "$ISO" \
		--network network=default,model=virtio${VM_MAC:+,mac=$VM_MAC} \
		--graphics spice,listen=127.0.0.1 --video vga \
		--console pty \
		--os-variant openbsd7.9 \
		--noautoconsole
	echo "domain created. Open virt-manager to run the installer, or: vm console"
	;;

bootstrap)
	check_libvirt
	tar -C "$REPO" -cf - . |
		ssh "$SSH_HOST" 'rm -rf ~/openbsd-setup && mkdir -p ~/openbsd-setup && tar -C ~/openbsd-setup -xf -'
	if ssh -o BatchMode=yes root@"$SSH_HOST" true 2>/dev/null; then
		ssh root@"$SSH_HOST" "cd /home/$GUEST_USER/openbsd-setup && ./provision.sh --vm"
	else
		if ! ssh "$SSH_HOST" 'test -f /etc/doas.conf' 2>/dev/null; then
			cat >&2 <<EOF
error: the guest has neither root SSH nor doas yet.

The installer does not create /etc/doas.conf. The repo is now in the
guest. Log in on the serial console as root (./vm console) and run:

  install -m 600 $GUEST_HOME/openbsd-setup/etc/doas.conf /etc/doas.conf

Then run './vm bootstrap' again.
EOF
			exit 1
		fi
		echo "root SSH not set up yet; falling back to doas (password prompt)." >&2
		ssh -t "$SSH_HOST" 'cd ~/openbsd-setup && doas ./provision.sh --vm'
	fi
	;;

up)      check_libvirt; $V start "$NAME" ;;
down)    $V shutdown "$NAME" ;;
off)     $V destroy "$NAME" ;;
status)
	$V list --all
	$V domifaddr "$NAME" --source lease 2>/dev/null || true
	;;

ssh)     shift; exec ssh "$SSH_HOST" "$@" ;;
console) exec $V console "$NAME" ;;
run)     shift; exec ssh "$SSH_HOST" "$*" ;;

snap)
	$V snapshot-create-as "$NAME" "${2:-snap-$(date +%Y%m%d-%H%M%S)}"
	;;

apply)
	check_libvirt
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	mkdir -p "$tmp/etc"
	cp -R "$REPO/etc/." "$tmp/etc/"
	[ -d "$REPO/etc-vm" ] && cp -R "$REPO/etc-vm/." "$tmp/etc/"
	(cd "$tmp" && tar -cf - etc) | ssh root@"$SSH_HOST" 'tar -C / -xpf -'
	ssh root@"$SSH_HOST" "find /etc -user $GUEST_USER -exec chown root:wheel {} + 2>/dev/null; chmod 600 /etc/doas.conf"
	(cd "$REPO/home" && tar -cf - .) |
		ssh root@"$SSH_HOST" "tar -C $GUEST_HOME -xpf - && chown -R $GUEST_USER:$GUEST_USER $GUEST_HOME"
	ssh root@"$SSH_HOST" 'sh -s' < "$REPO/validate.sh"
	ssh root@"$SSH_HOST" 'rcctl reload sshd || rcctl restart sshd'
	echo "applied and validated"
	;;

capture)
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	ssh root@"$SSH_HOST" "tar -C / -cf - \
		etc/doas.conf etc/installurl etc/pf.conf etc/sysctl.conf \
		etc/myname etc/hostname.vio0 etc/boot.conf etc/ttys \
		etc/wsconsctl.conf etc/ssh/sshd_config etc/ssh/sshd_config.d \
		etc/X11 etc/rc.conf.local etc/unwind.conf etc/hotplug etc/apm \
		etc/chromium \
		home/$GUEST_USER/.profile home/$GUEST_USER/.kshrc home/$GUEST_USER/.xsession \
		home/$GUEST_USER/.spectrwm.conf home/$GUEST_USER/.Xresources \
		home/$GUEST_USER/.tmux.conf home/$GUEST_USER/.gitconfig home/$GUEST_USER/.config \
		2>/dev/null" | tar -C "$tmp" -xf - 2>/dev/null || true

	mkdir -p "$REPO/etc" "$REPO/etc-vm" "$REPO/home"
	for f in hostname.vio0 boot.conf ttys rc.conf.local; do
		[ -e "$tmp/etc/$f" ] && mv "$tmp/etc/$f" "$REPO/etc-vm/$f"
	done
	[ -d "$tmp/etc" ] && cp -R "$tmp/etc/." "$REPO/etc/"
	[ -d "$tmp/home/$GUEST_USER" ] && cp -R "$tmp/home/$GUEST_USER/." "$REPO/home/"
	git -C "$REPO" diff --stat || true
	echo "captured; review with: git -C $REPO diff"
	;;

rebuild)
	$V destroy "$NAME" 2>/dev/null || true
	$V undefine "$NAME" --nvram 2>/dev/null || true
	rm -f "$DISK"
	exec "$0" new
	;;

*)
	usage
	exit 1
	;;
esac
